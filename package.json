{
  "name": "google-goto-url-fix",
  "version": "1.0.4",
  "private": true,
  "description": "Cross-browser extension that restores copyable Google result links.",
  "scripts": {
    "build": "node scripts/build.js",
    "version:set": "node scripts/set-version.js",
    "lint:firefox": "npm run build && web-ext lint --source-dir dist/firefox",
    "sign:firefox": "node scripts/sign-firefox.js",
    "sign:safari": "node scripts/sign-safari.js",
    "test": "node --test test/*.test.js",
    "test:browser": "sh scripts/test-browser-fixture.sh",
    "test:prefetch": "sh scripts/test-prefetch-fixture.sh",
    "test:e2e": "node test/extension-e2e.js",
    "test:serve": "node scripts/serve-fixture.js",
    "check": "npm run build && npm test"
  }
}
